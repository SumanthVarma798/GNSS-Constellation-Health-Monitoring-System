# Copy to .env (which is git-ignored) and fill in. Never commit real values.
SPACETRACK_USERNAME=
SPACETRACK_PASSWORD=

# The gate in front of the local Ollama (scripts/ollama_gate.py); a long random value: openssl rand -hex 32.
# The shared console sends the same value as [assistant] key in its Streamlit secrets.
OLLAMA_GATE_KEY=
